
;==========================================================================
;                       (UPH) UNIVERSAL PROGRAM HEADER                            
;==========================================================================
;                              Copy—&—Paste 
;==========================================================================
;                                   —
;==========================================================================
;   OBJECTIVE: IMPLEMENT THE EXAMPLE IN FIGURE 6.11
;-------------------------------------------------------------------------
;   1. FIND FIRST SET BIT IN THE WORD
;==========================================================================
;                          HIGH-LEVEL BREAKDOWN     
;-------------------------------------------------------------------------
;   1. RUN A LOOP WHERE WE LEFT SHIFT, CHECK IF NEGATIVE, AND BRANCH IF 
;      NOT FOUND
;==========================================================================
;                          REGISTER CONVENTION
;==========================================================================
;-------------------------------------------------------------------------
; R0    : Unused         
; EOP   : 0
;-------------------------------------------------------------------------
; R1    : Loop counter / decrementing value
; EOP   : 0 (if loop completes)
;-------------------------------------------------------------------------
; R2    : Value loaded via LDI and manipulated
; EOP   : Final doubled value or negative trigger
;-------------------------------------------------------------------------
; R3    : Unused
; EOP   : 0
;-------------------------------------------------------------------------
; R4    : Unused
; EOP   : 0
;-------------------------------------------------------------------------
; R5    : Unused
; EOP   : 0
;-------------------------------------------------------------------------
; R6    : Unused
; EOP   : 0
;-------------------------------------------------------------------------
; R7    : Unused
; EOP   : 0
;==========================================================================
;-------------------------------------------------------------------------
;   .ORIG x3000
;-------------------------------------------------------------------------
; Figure 6.11 — LC-3 binary (.bin) listing with comments
; Address labels shown only for clarity; file contents are the 16-bit words below
;-------------------------------------------------------------------------
    0011 0000 0000 0000
    0101001000100000        ; AND  R1, R0, #0           ;  0.  R1 <- 0
    0001001001101111        ; ADD  R1, R1, #15          ;  1.  R1 <- R1 + 15
    1010 010 0 0000 1000    ; PC + x0008 = x300B        ;  2.  R2 <- M[M[x300B]]
    0000100000000100        ; BRn  x3008                ;  3.  if (R2 < 0) goto x300A
    0001010010000010        ; ADD  R2, R2, R2           ;  4.  R2 <- R2 + R2 (shift left)
    0000 100 000000001      ; BRn  x3008                ;  5.  if (R2 < 0) goto x300A
    0001001001111111        ; ADD  R1, R1, #-1          ;  6.  R1 <- R1 - 1
    0000 110 000000001      ; BRnz                      ;  7.  if (R1 <= 0), go_to x300A
    0000 111 111111011      ; BRnzp x3004               ;  8.  go to x3006
    0001001001111111        ; ADD  R1, R1, #-1          ;  6.  R1 <- R1 - 1
    1111000000100101        ; TRAP x25 (HALT)           ;  9.  HALT
    0011010000000000        ; .FILL x3400               ;  10. x300A contains x3400
;-------------------------------------------------------------------------
;; SHOULD RETURN -1