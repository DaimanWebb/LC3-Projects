;                       (UPH) UNIVERSAL PROGRAM HEADER                            
;==========================================================================
;                              Copy—&—Paste 
;==========================================================================
;                                   —
;==========================================================================
;   OBJECTIVE: IMPLEMENT THE EXAMPLE IN MISC.BIN — CONDITIONAL LOOP WITH MEMORY ACCESS
;-------------------------------------------------------------------------
;   1. Perform arithmetic and memory operations in a loop.
;   2. Halt when a condition is met based on register comparison.
;==========================================================================
;                          HIGH-LEVEL BREAKDOWN     
;-------------------------------------------------------------------------
;   1. Initialize registers and load a value from memory.
;   2. Perform arithmetic and conditional branching.
;   3. Loop until a condition triggers a halt.
;==========================================================================
;                          REGISTER CONVENTION
;==========================================================================
;-------------------------------------------------------------------------
; R0    : Unused         
; EOP   : 0
;-------------------------------------------------------------------------
; *R1   : ADDRESS OF THE ARRAY
; EOP   : ADDRESS POINTING TO NULL
;-------------------------------------------------------------------------
; R2    : COUNTER
; EOP   : 0
;-------------------------------------------------------------------------
; R3    : RUNNING SUM
; EOP   : 
;-------------------------------------------------------------------------
; *R4   : Memory-loaded value (FROM R1)
; EOP   : LAST VALUE IN ARRAY
;-------------------------------------------------------------------------
; R5    : Unused
; EOP   : 0
;-------------------------------------------------------------------------
; R6    : Unused
; EOP   : 0
;-------------------------------------------------------------------------
; R7    : Unused
; EOP   : 0
;==========================================================================
    0011000000000000        ; .ORIG x3000
    1110 001 00000 1001     ; LEA R1 x003           ;   0. R1 <- M[PC] + x003 = x3001 + x009 = x300A
    0101 011 011 1 00000    ; AND R3 R3 x0          ;   1. CLEAR R3
    0101 010 010 0 00011    ; AND R2 R2 R3          ;   2. CLEAR R2 USING R3 (ALREADY 0)
    0001 010 010 1 01100    ; ADD R2 R2 x0C         ;   3. ADD x0C (#12) TO R2 AS THE COUNTER
    0110 100 001 000000     ; LDR R4 R1 x0          ;   4. LOAD DATA AT R1 INTO R4
    0001 011 011 0 00100    ; ADD R3 R3 R4          ;   5. ADD R4 INTO RUNNING SUM R3
    0001 001 001 1 00001    ; ADD R1 R1 x1          ;   6. INCREMENT ARRAY ADDRESS
    0001 010 010 1 11111    ; ADD R2 R2 x-1         ;   7. DECREMENT COUNTER
    0000 001 111111011      ; BRp x1FB              ;   8. M[PC] + 101 = x3009 + (-5) = x3004
    1111 0000 00100101      ; TRAP x25              ;   9. HALT
    
    